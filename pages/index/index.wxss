.page {
  padding: 32rpx 24rpx 48rpx;
}

.header {
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  display: block;
}

.subtitle {
  margin-top: 8rpx;
  color: #666;
  font-size: 26rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
}

.section + .section {
  margin-top: 28rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
  display: block;
}

.picker {
  padding: 16rpx 20rpx;
  background: #f1f8f4;
  border-radius: 12rpx;
  color: #2e7d32;
}

.duration {
  display: flex;
  gap: 24rpx;
}

.duration-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
}

.slots {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.slot {
  flex: 0 0 calc(50% - 8rpx);
  padding: 16rpx 12rpx;
  border-radius: 12rpx;
  border: 2rpx solid #dfe7e2;
  background: #f9fbfa;
  font-size: 24rpx;
  color: #2e7d32;
}

.slot.active {
  border-color: #2e7d32;
  background: #e5f4ea;
}

.slot.disabled {
  color: #aaa;
  border-color: #eee;
  background: #f3f3f3;
}

.hint {
  display: block;
  margin-top: 12rpx;
  color: #888;
  font-size: 22rpx;
}

.footer {
  margin-top: 32rpx;
  background: #fff;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.08);
}

.deposit {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.desc {
  color: #666;
  font-size: 22rpx;
}

.submit {
  background: #2e7d32;
  color: #fff;
  border-radius: 14rpx;
  font-size: 28rpx;
  padding: 12rpx 0;
}
